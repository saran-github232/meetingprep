# Paste an API key for whichever provider you use below — only the one selected in
# Settings > AI Provider is read. This file is gitignored — it never leaves your machine.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Firebase project config for the Resources (Admin/User) feature — see README >
# "Resources (Admin/User) setup" for how to create these. Unlike the keys above, these
# VITE_-prefixed values are bundled into the app UI (Firebase web config isn't secret;
# access is controlled by the security rules on the project, not by hiding this).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
